# Backend env — copy to backend/.env and fill in.
#
# DO NOT commit your actual .env to git. The repo's .gitignore enforces this.

# ── Supabase (required) ─────────────────────────────────────────────────────
# Project URL + anon key from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
# service_role key — bypasses RLS, BACKEND-ONLY, never expose to frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# ── OpenAI (required) ───────────────────────────────────────────────────────
# Used by the listing parser + slot extractor (gpt-4o-mini).
OPENAI_API_KEY=sk-...

# ── OneMap (required for geo-aware scheduling) ──────────────────────────────
# Register a free account at https://www.onemap.gov.sg/apidocs/register
# Either supply ONEMAP_EMAIL + ONEMAP_PASSWORD (auto-refreshes), or
# ONEMAP_TOKEN (a 3-day static token).
ONEMAP_EMAIL=you@example.com
ONEMAP_PASSWORD=your-password
# ONEMAP_TOKEN=eyJhbGc...

# ── Optional ────────────────────────────────────────────────────────────────
# Override the backend port (default 8787)
# PORT=8787
