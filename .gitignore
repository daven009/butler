**/.env.local
**/.env.production
**/.env.*.local

# ─── Logs ───────────────────────────────────────────────
.logs/
**/.logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS / IDE ───────────────────────────────────────────
.DS_Store
**/.DS_Store
.idea/
.vscode/
*.swp

