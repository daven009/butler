# Web env — copy to web/.env.local and fill in.
#
# Only put PUBLIC values here. The web bundle is shipped to browsers.
# DO NOT put SUPABASE_SERVICE_ROLE_KEY or OPENAI_API_KEY here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...

# When deploying behind a reverse proxy that fronts the backend at a
# different path, override here. Defaults to "/api" which works when web
# and backend are served from the same origin.
# VITE_API_BASE=/api
